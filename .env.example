# ============================================================
# متغيرات البيئة الخاصة بمشروع NOORMEXA
# ============================================================
# انسخ هذا الملف باسم .env.local عشان تشتغل محليًا:
#   cp .env.example .env.local
#
# وبعد كده حط نفس القيم فى إعدادات المشروع على Vercel:
#   Vercel Dashboard > Project > Settings > Environment Variables
#
# القيم دي هتلاقيها فى مشروع Supabase بتاعك من:
#   Supabase Dashboard > Project Settings > API
# ============================================================

# رابط مشروع Supabase (Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# المفتاح العام (anon / public key) - آمن يتحط فى الفرونت إند
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# ============================================================
# المساعد الذكي (اختياري) — لو مش مضاف، الموقع هيشتغل عادي بدون شات
# ============================================================
# الخيار المجاني (موصى بيه للبداية) — Google Gemini
# هاته من: https://aistudio.google.com/apikey  (مجاني، بدون بطاقة ائتمان)
GEMINI_API_KEY=

# اختياري: تحديد الموديل (لو سبته فاضي هيستخدم Flash المجاني تلقائيًا)
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------
# بديل مدفوع (Anthropic Claude) — استخدمه بدل Gemini لو حبيت لاحقًا
# لو الاتنين المفتاحين موجودين، الموقع هيفضّل Gemini تلقائيًا.
# ------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ============================================================
# الدفع الإلكتروني (اختياري) — لو مضفتش أي منهم، الموقع هيشتغل
# بـ "الدفع عند الاستلام" بس، ومفيش أي مشكلة فى ده.
# ============================================================

# مفتاح Service Role (سري جدًا، للسيرفر فقط) — مطلوب عشان الدفع
# يشتغل، هتلاقيه فى: Supabase Dashboard > Project Settings > API
# > Project API keys > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# رابط موقعك الحقيقي (بدون / فى الآخر) — يُستخدم بعد إتمام الدفع
NEXT_PUBLIC_SITE_URL=https://noormexa-platform-2026.vercel.app

# ------------------------------------------------------------
# Paymob (موصى بيه لمصر/العربي) — https://accept.paymob.com
# ------------------------------------------------------------
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
# اختياري لكن موصى بيه بشدة (تأكيد أمني إن الدفع حقيقي) — من
# Paymob Dashboard > Settings > Payment Integrations > HMAC
PAYMOB_HMAC_SECRET=

# ------------------------------------------------------------
# Stripe (للعملاء الدوليين) — https://dashboard.stripe.com
# ------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
